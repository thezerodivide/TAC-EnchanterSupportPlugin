             setXtForce            = runtime.setXtForce,
             setXtIgnore           = runtime.setXtIgnore,
@@ -7314,6 +7472,7 @@ function runtime.initPluginManager()
         if p.instance.onDestroy then
             pcall(p.instance.onDestroy)
